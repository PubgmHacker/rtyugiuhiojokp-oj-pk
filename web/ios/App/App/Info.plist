<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>ru</string>
	<key>CFBundleDisplayName</key>
	<string>Souldawn</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- ── Разрешения. Эти формулировки пользователь видит в системном
	     запросе; Apple отклоняет сборку с пустыми или общими текстами.
	     Здесь только те разрешения, которые приложение реально запрашивает:
	     заявленное, но неиспользуемое разрешение — повод для Metadata
	     Rejected по Guideline 5.1.1. Face ID и трекинг убраны, потому что
	     биометрического замка и аналитики в коде нет — вернуть строки нужно
	     вместе с самими функциями.
	     Микрофон вернули вместе с голосовой рулеткой: без этой строки iOS
	     убивает приложение при первом же getUserMedia, а не показывает
	     системный запрос ── -->
	<key>NSCameraUsageDescription</key>
	<string>Камера нужна, чтобы вы могли снять и добавить фото в свою анкету.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Микрофон нужен для голосовой рулетки — случайных голосовых звонков. Мы не записываем разговоры.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Доступ к фото нужен, чтобы вы могли выбрать снимки для анкеты.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Геопозиция нужна, чтобы показывать людей рядом с вами и расстояние до них.</string>

	<!-- ── Сцены ── -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- Свайп-дека рассчитана на портрет; в ландшафте теряет смысл -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>

	<!-- Тёмная тема — единственная в дизайн-системе -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- Фоновый режим для пушей о новых мэтчах и сообщениях -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!-- Открытие Telegram по deep link -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tg</string>
		<string>telegram</string>
	</array>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
