# ── SIMP DATING — Environment Variables ─────────────────────────
# Скопируй: cp .env.example .env

# ── Telegram Bot ────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_from_botfather
BOT_USERNAME=simpmatchbot

# ── Admin ──────────────────────────────────────────────────────
ADMIN_IDS=123456789,987654321

# ── Блокировки ──────────────────────────────────────────────────
# Цена досрочной разблокировки, ₽. Бот выставляет Stars-счёт по курсу
# RUB_PER_STAR (bot/config.py), веб показывает цену на экране «Доступ
# закрыт». Меняя здесь — задай то же значение в VITE_UNBAN_PRICE_RUB,
# иначе экран в вебе будет обещать одну цену, а бот выставит другую.
UNBAN_PRICE_RUB=349
VITE_UNBAN_PRICE_RUB=349

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://simp:simp_dating_dev@localhost:5433/simp_dating
# Пул соединений НА ПРОЦЕСС API. Считать парой с числом воркеров:
# воркеры × (DB_POOL_SIZE + DB_MAX_OVERFLOW) + журнальный пул (2 на воркер)
# + пул бота (30) должны быть меньше max_connections Postgres (у Railway
# по умолчанию 100). Дефолты 12+18 при 2 воркерах дают 60 + 4 + 30 = 94 —
# расчёт в api/database/connection.py, менять только вместе с ним.
DB_POOL_SIZE=12
DB_MAX_OVERFLOW=18

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── API ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=change_this_to_random_64_char_string_in_production
# DEBUG=true включает /docs, гостевой вход /auth/dev и fail-open проверку
# initData без BOT_TOKEN. ТОЛЬКО для локальной разработки — в проде убрать!
DEBUG=true
# Сколько доверенных прокси стоит перед API. Railway ставит один свой edge,
# поэтому дефолт 1. По этому числу берётся реальный адрес клиента из
# X-Forwarded-For (N-й справа): левые элементы клиент подставляет сам, и по
# ним крутится ключ лимита частоты. 0 = не доверять заголовку, брать TCP-пир.
# Меняйте, только если знаете свою цепочку прокси.
TRUSTED_PROXY_COUNT=1
# Домены фронтенда через запятую — браузер отбросит ответ API с чужого origin.
# Пусто/не задано = дефолт из api/config.py: localhost и 127.0.0.1 на портах
# 5173 (vite), 4173 (preview) и 4180 (tools/screenshot.py). Это разные origin'ы
# для браузера, поэтому в списке оба хоста. В проде домен обязателен: дефолт
# сузит доступ до localhost, и приложение получит пустые экраны вместо данных.
# Звёздочка работает только при DEBUG=true.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:4180,http://127.0.0.1:4180

# ── Web frontend ────────────────────────────────────────────────
# URL веб-приложения — используется ботом для кнопок Web App
SITE_URL=http://localhost:5173
# Юридические страницы для ссылок в боте. Пусто = те же, что SITE_URL
# (privacy.html / terms.html отдаёт веб). Telegram на телефоне localhost
# не откроет — для меню Dating нужен HTTPS (туннель) в SITE_URL.
LANDING_URL=
# Build-time переменные фронтенда (Vite)
VITE_API_URL=http://localhost:8000
VITE_BOT_USERNAME=simpmatchbot
# Домен юридических страниц для сборки. Пусто = origin, откуда открыто
# приложение (веб и Telegram Mini App отдают свои копии из web/public).
# В нативной сборке origin — capacitor://localhost, открыть такое нечем,
# поэтому там подставляется https://simp.app. Задавать имеет смысл для
# стейджинга: VITE_SITE_URL=https://staging.simp.app
VITE_SITE_URL=

# ── Cloudflare R2 (фото пользователей) ─────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=simp-dating
R2_PUBLIC_URL=https://dating-media.yourdomain.com

# ── Zhipu AI (GLM) ─────────────────────────────────────────────
# Ключ дают две площадки Zhipu, и он у них НЕ взаимозаменяем:
# • материковая https://open.bigmodel.cn — регистрация по телефону
#   (российские номера не принимает);
# • международная https://z.ai — регистрация по почте или Google,
#   работает откуда угодно. Для её ключа обязательны ZHIPU_BASE_URL
#   и имена моделей этой площадки — раскомментируйте три строки ниже.
# Один ключ читают оба сервиса: api и bot.
ZHIPU_API_KEY=your_zhipu_ai_api_key
# Пусто/не задано = материковый адрес с моделями glm-4-flash/glm-4v-flash.
# На Z.ai бесплатные: glm-4.5-flash (текст) и glm-4.6v-flash (фото).
# ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4
# ZHIPU_TEXT_MODEL=glm-4.5-flash
# ZHIPU_VISION_MODEL=glm-4.6v-flash

# ── Sumsub: проверка «живости» через KYC-провайдера ───────────
# Необязательно. Пока App Token, Secret и Level не заданы, проверка
# профиля работает встроенной схемой (позы + GLM). С ключами галочку
# выдаёт связка «Liveness от Sumsub + наша сверка лица с анкетой».
# App Token и Secret — из дашборда: Dev space → App tokens.
# Level — имя уровня, чувствительно к регистру. ВАЖНО: соберите уровень
# из ОДНОГО шага Selfie (Liveness) — человек только крутит головой перед
# камерой. Документы (паспорт, ID) НЕ запрашиваются: шаг Identity document
# в уровень не добавляйте, для галочки знакомств он не нужен.
# Webhook secret — из Webhook manager, вебхук: POST /verification/sumsub/webhook.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=
SUMSUB_WEBHOOK_SECRET=
# Адрес API Sumsub. Менять не нужно: песочница живёт на том же хосте
# (её включает сам App Token из Dev space), отдельного URL у неё нет.
SUMSUB_BASE_URL=https://api.sumsub.com

# ── TURN для голосовой рулетки ────────────────────────────────
# Без TURN звонок не соберётся у части людей: симметричный NAT
# мобильных операторов одним STUN не пробивается. Это не
# «улучшение качества», а условие работы фичи в мобильных сетях.
# Подойдёт свой coturn или любой платный сервис (Twilio, Metered,
# Cloudflare Calls). Состояние видно в /health как turn=disabled.
TURN_URL=turn:turn.yourdomain.com:3478
TURN_USERNAME=your_turn_username
TURN_PASSWORD=your_turn_password

# ── Почта: восстановление доступа ─────────────────────────────
# Единственный способ вернуть аккаунт, если потерян Telegram — вместе
# с ним теряется и оплаченная подписка. Без SMTP_HOST/SMTP_FROM письма
# не уходят, и API отвечает честной ошибкой (в DEBUG код пишется в лог).
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourdomain.com

# ── Алертинг (необязательно) ──────────────────────────────────
# Пусто — полный no-op: пакет sentry_sdk даже не импортируется.
# Одна переменная на оба процесса: API и бот. События бота помечены
# server_name=simp-dating-bot, иначе два потока стектрейсов в одном
# проекте Sentry не различить. На Railway задать в ОБОИХ сервисах.
SENTRY_DSN=

# ── App Store IAP: покупка подписки в iOS ─────────────────────
# Идентификаторы продуктов НЕ настраиваются переменными: они живут в
# `api/services/plans.py` (поле `Plan.appstore_id`), потому что продукт —
# это уровень плюс срок, а не одна пара «месяц/год». Оттуда же собирается
# `web/ios/App/Simp.storekit`, и совпадение стережёт
# `api/tests/test_appstore.py`. В App Store Connect заведите ровно те же
# девять идентификаторов: plus/ultra/aurora × monthly/quarterly/yearly.
# APPSTORE_APP_APPLE_ID — числовой Apple ID приложения из App Store
# Connect. Пока он не задан, покупка в приложении не предлагается:
# иначе оплата прошла бы, а подписка не начислилась.
APPSTORE_APP_APPLE_ID=
APPSTORE_BUNDLE_ID=com.simp.dating
# Сборки из Xcode, TestFlight и App Review покупают в песочнице
APPSTORE_USE_SANDBOX=false

# ── APNs: пуши в iOS-приложение ───────────────────────────────
# Ключ создаётся в Apple Developer Portal → Keys → Apple Push
# Notifications service, файл .p8 скачивается один раз.
# Пока ключ не задан, пуши не отправляются: приложение работает,
# уведомления приходят только внутри Telegram.
# Содержимое .p8 целиком, переводы строк — как \n:
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.simp.dating
# Сборки из Xcode и TestFlight регистрируются в песочнице APNs —
# прод-хост вернёт для них BadDeviceToken
APNS_USE_SANDBOX=false

# ── Premium / Оплата ──────────────────────────────────────────
# Цены, сроки и содержимое уровней здесь НЕ настраиваются: линейка живёт в
# `api/services/plans.py` (PLANS — цена в рублях и срок, TIERS — лимиты,
# суперлайки и перки), потому что продукт — это уровень плюс срок, а не одна
# цена. Оттуда же берутся идентификаторы App Store и `Simp.storekit`.
#
# Здесь только курсы пересчёта рублёвой цены в единицы платёжных систем:
# Stars и USDT ходят по своему курсу, а линейка обязана остаться одной для
# всех способов оплаты — иначе один и тот же уровень стоит по-разному в
# зависимости от того, чем человек платит.
RUB_PER_STAR=1.9
RUB_PER_USDT=95
# CryptoBot: токен из @CryptoBot → Crypto Pay → Create App.
# Пусто = способ скрыт в боте.
CRYPTOBOT_TOKEN=
# Рубли (карта и СБП): токен платёжного провайдера из BotFather →
# /mybots → Payments → ЮKassa (или другой провайдер, они же дают СБП).
# Пусто = способ скрыт, как и у CryptoBot. Тестовый токен провайдера
# оканчивается на «:TEST» — на нём проходит весь сценарий без списания.
# Цену в счёт Telegram принимает в копейках, пересчёт делает бот.
PAYMENT_PROVIDER_TOKEN=

# ── Реферальная программа ──────────────────────────────────────
# Сколько друзей нужно пригласить и на сколько % бустить анкету (10–15)
REFERRAL_MIN_INVITES=3
REFERRAL_BOOST_PERCENT=12

# ── Тонкая настройка (по умолчанию задана в коде) ──────────────
# Раскомментируйте, только если меняете значение: пустая переменная в .env
# перебивает дефолт и превращается в 0 или пустую строку.
#
# Возрастной порог. 18 — не свободное число: он же стоит в оферте
# (landing/terms.html) и в анкете App Store (APPSTORE.md), и расхождение
# между ними — юридическая, а не косметическая проблема. Сверяется тестом
# api/tests/test_age_floor.py, менять нужно во всех местах сразу.
# MIN_AGE=18
# MAX_AGE=99
# Анкета: фото, видео, длина «о себе», число интересов
# MAX_PHOTOS=5
# MAX_PROFILE_VIDEOS=3
# MAX_BIO_LENGTH=500
# MAX_INTERESTS=10
# Сколько анкет отдаётся за один запрос деки
# DECK_SIZE=10
# JWT: алгоритм подписи и срок жизни токена в часах
# JWT_ALGORITHM=HS256
# JWT_ACCESS_EXPIRE_HOURS=72
# Антифлуд бота: минимальный интервал между действиями одного человека,
# в секундах — для сообщений и для нажатий на кнопки
# THROTTLE_MESSAGE=0.7
# THROTTLE_CALLBACK=0.4
# Порт health-сервера бота. Railway подставляет свой PORT и он приоритетнее
# WEBHOOK_PORT=8081
# Отложенные пуши онбординга (bot/services/nudges.py): совет про субкультуру
# уходит через 45 минут после согласия или конца анкеты, просьба привязать
# почту — через сутки; строки старше недели удаляются без отправки
# NUDGE_STYLE_DELAY_MIN=45
# NUDGE_EMAIL_DELAY_HOURS=24
# NUDGE_MAX_AGE_DAYS=7

# ── Что ещё не подключено ─────────────────────────────────────
# Stripe и Apple Sign-In в коде отсутствуют — переменных для них нет
# намеренно. Ключ-заглушка в .env выглядит как настройка работающей оплаты,
# и её отсутствие обнаруживается уже на живых людях. Появится реализация —
# появятся и переменные, вместе с ней.
