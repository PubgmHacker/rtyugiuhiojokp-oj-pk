# ── SOULDAWN DATING — Environment Variables ─────────────────────
# Скопируй: cp .env.example .env

# ── Telegram Bot ────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_from_botfather
BOT_USERNAME=souldawn_dating_bot

# ── Admin ──────────────────────────────────────────────────────
ADMIN_IDS=123456789,987654321

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://souldawn:souldawn_dating_dev@localhost:5433/souldawn_dating

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0

# ── API ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=change_this_to_random_64_char_string_in_production
API_BASE_URL=http://localhost:8000
# DEBUG=true включает /docs, гостевой вход /auth/dev и fail-open проверку
# initData без BOT_TOKEN. ТОЛЬКО для локальной разработки — в проде убрать!
DEBUG=true

# ── Web frontend ────────────────────────────────────────────────
# URL веб-приложения — используется ботом для кнопок Web App
SITE_URL=http://localhost:5173
# Build-time переменные фронтенда (Vite)
VITE_API_URL=http://localhost:8000
VITE_BOT_USERNAME=souldawn_dating_bot

# ── Cloudflare R2 (фото пользователей) ─────────────────────────
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=souldawn-dating
R2_PUBLIC_URL=https://dating-media.yourdomain.com

# ── Zhipu AI (GLM-5.2) ────────────────────────────────────────
ZHIPU_API_KEY=your_zhipu_ai_api_key

# ── TURN для голосовой рулетки ────────────────────────────────
# Без TURN звонок не соберётся у части людей: симметричный NAT
# мобильных операторов одним STUN не пробивается. Это не
# «улучшение качества», а условие работы фичи в мобильных сетях.
# Подойдёт свой coturn или любой платный сервис (Twilio, Metered,
# Cloudflare Calls). Состояние видно в /health как turn=disabled.
TURN_URL=turn:turn.yourdomain.com:3478
TURN_USERNAME=your_turn_username
TURN_PASSWORD=your_turn_password

# ── Почта: восстановление доступа ─────────────────────────────
# Единственный способ вернуть аккаунт, если потерян Telegram — вместе
# с ним теряется и оплаченная подписка. Без SMTP_HOST/SMTP_FROM письма
# не уходят, и API отвечает честной ошибкой (в DEBUG код пишется в лог).
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourdomain.com

# ── Алертинг (необязательно) ──────────────────────────────────
# Пусто — полный no-op: пакет sentry_sdk даже не импортируется.
SENTRY_DSN=

# ── App Store IAP: покупка подписки в iOS ─────────────────────
# Идентификаторы продуктов НЕ настраиваются переменными: они живут в
# `api/services/plans.py` (поле `Plan.appstore_id`), потому что продукт —
# это уровень плюс срок, а не одна пара «месяц/год». Оттуда же собирается
# `web/ios/App/Souldawn.storekit`, и совпадение стережёт
# `api/tests/test_appstore.py`. В App Store Connect заведите ровно те же
# девять идентификаторов: plus/ultra/aurora × monthly/quarterly/yearly.
# APPSTORE_APP_APPLE_ID — числовой Apple ID приложения из App Store
# Connect. Пока он не задан, покупка в приложении не предлагается:
# иначе оплата прошла бы, а подписка не начислилась.
APPSTORE_APP_APPLE_ID=
APPSTORE_BUNDLE_ID=com.souldawn.dating
# Сборки из Xcode, TestFlight и App Review покупают в песочнице
APPSTORE_USE_SANDBOX=false

# ── APNs: пуши в iOS-приложение ───────────────────────────────
# Ключ создаётся в Apple Developer Portal → Keys → Apple Push
# Notifications service, файл .p8 скачивается один раз.
# Пока ключ не задан, пуши не отправляются: приложение работает,
# уведомления приходят только внутри Telegram.
# Содержимое .p8 целиком, переводы строк — как \n:
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.souldawn.dating
# Сборки из Xcode и TestFlight регистрируются в песочнице APNs —
# прод-хост вернёт для них BadDeviceToken
APNS_USE_SANDBOX=false

# ── Premium / Оплата (введите свои значения) ──────────────────
# Длительность подписки в днях и цены по способам оплаты
PREMIUM_DAYS=30
PREMIUM_PRICE_STARS=250
# CryptoBot: токен из @CryptoBot → Crypto Pay → Create App.
# Пусто = способ скрыт в боте.
CRYPTOBOT_TOKEN=
PREMIUM_PRICE_USDT=3
# СБП: включится после подключения провайдера (пока кнопка-заглушка)
SBP_ENABLED=false

# ── Реферальная программа ──────────────────────────────────────
# Сколько друзей нужно пригласить и на сколько % бустить анкету (10–15)
REFERRAL_MIN_INVITES=3
REFERRAL_BOOST_PERCENT=12

# ── Суперлайки ─────────────────────────────────────────────────
# Ограниченный ресурс: безлимитный суперлайк ничего не значит ни для
# отправителя, ни для получателя. Остаток считается по таблице лайков
# за последние сутки, поэтому не теряется при перезапуске Redis.
SUPERLIKES_PER_DAY=1
SUPERLIKES_PER_DAY_PREMIUM=5

# ── Stripe (Premium подписка — потом) ────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_MONTHLY=

# ── Apple Sign-In (для iOS App Store) ─────────────────────────
# APPLE_TEAM_ID=
# APPLE_SERVICE_ID=
# APPLE_PRIVATE_KEY_PATH=
